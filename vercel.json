{
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/db.js"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/site/index.html"
    },
    {
      "source": "/admin",
      "destination": "/site/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/site/index.html"
    }
  ]
}
