# Required for first admin provisioning. Use unique, strong credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Admin sessions default to 60 minutes. Allowed range: 15-720.
ADMIN_SESSION_DURATION_MINUTES=60

# Neon Postgres connection string. Required for Vercel deployments.
DATABASE_URL=

# Admin deployment and database location.
# Optional canonical URL; Vercel deployment URLs are detected automatically.
APP_ORIGIN=
PORT=3000
GSQUAD_DB_PATH=data/gsquad.sqlite
# Optional reverse-proxy trust setting; configure only for a trusted proxy.
TRUST_PROXY=

# Optional fallback credentials; backend only. Live trading remains disabled.
DERIV_PAT=
DERIV_APP_ID=
# Required to save a PAT from admin settings. Generate with: openssl rand -base64 32
GSQUAD_SECRETS_KEY=

# Required for member email verification and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
